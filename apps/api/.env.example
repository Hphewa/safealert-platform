PORT=4000
NODE_ENV=development

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_PATH=/api/v1/media

# Development-only privileged account seed values.
# Do not use these in production. Prefer local .env values.
SEED_VOLUNTEER_EMAIL=volunteer@example.com
SEED_VOLUNTEER_PASSWORD=
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=
SEED_RESPONDER_EMAIL=responder@example.com
SEED_RESPONDER_PASSWORD=

# LDFEW-127 targeted notification delivery. Leave the secret values empty here; real values
# belong only in the developer's local apps/api/.env.
SMS_PROVIDER=notifylk
NOTIFICATION_SMS_MOCK_ENABLED=false
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=NotifyDEMO

# Firebase Cloud Messaging service account (backend only).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

NOTIFICATION_COUNTRY_NAME=Sri Lanka
