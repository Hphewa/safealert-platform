PORT=4000
NODE_ENV=development

MONGODB_URI=

# Optional persistent directory for report evidence. Defaults to apps/api/uploads/report-evidence.
REPORT_EVIDENCE_DIRECTORY=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Development-only privileged account seed values.
# Do not use these in production. Prefer local .env values.
SEED_VOLUNTEER_EMAIL=volunteer@example.com
SEED_VOLUNTEER_PASSWORD=
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=
SEED_RESPONDER_EMAIL=responder@example.com
SEED_RESPONDER_PASSWORD=
