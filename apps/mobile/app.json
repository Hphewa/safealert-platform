{
  "expo": {
    "name": "SafeAlert",
    "slug": "safealert",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "safealert",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SafeAlert to use your location when reporting nearby hazards."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
