{
  "expo": {
    "name": "SafeAlert",
    "slug": "safealert",
    "version": "0.1.0",
    "icon": "./assets/safealert-logo.png",
    "splash": {
      "image": "./assets/safealert-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#102a43"
    },
    "orientation": "portrait",
    "scheme": "safealert",
    "android": {
      "package": "com.safealert.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/safealert-logo.png",
        "backgroundColor": "#102a43"
      },
      "googleServicesFile": "./google-services.json"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SafeAlert to use your location when reporting nearby hazards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SafeAlert to select a photo as optional hazard evidence.",
          "cameraPermission": "Allow SafeAlert to take a photo as optional hazard evidence."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-audio"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
