# Values prefixed with EXPO_PUBLIC_ are bundled into the client app.
# Treat them as public and never place backend secrets here.
# For physical devices, use your computer's LAN IP instead of localhost.
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.1:4000/api/v1
# 192.168.1.1