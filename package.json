{
  "name": "safealert-platform",
  "version": "0.1.0",
  "private": true,
  "description": "SafeAlert monorepo foundation for a disaster and flood warning platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @safealert/mobile run start",
    "api": "npm --workspace @safealert/api run dev",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "build": "npm --workspaces --if-present run build"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.34.0",
    "expo": "^57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
