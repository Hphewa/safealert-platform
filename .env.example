# Root-level local environment notes.
# Keep real secrets in local .env files only. Never commit them.

# Public API URL used by the mobile app during development.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend configuration belongs in apps/api/.env.
# Mobile EXPO_PUBLIC_* values are client-visible and must never contain secrets.

# Backend local media storage defaults. Keep uploaded files out of source control.
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_PATH=/api/v1/media

# LDFEW-127 notification delivery. Real credentials belong in local .env files only and must
# never be committed, logged, or exposed to the mobile app.
SMS_PROVIDER=notifylk
NOTIFICATION_SMS_MOCK_ENABLED=false
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=NotifyDEMO

# Firebase Cloud Messaging service account (backend only). Use either the three values below
# or FIREBASE_SERVICE_ACCOUNT_PATH pointing at a local service-account JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Country matched by a WHOLE_COUNTRY notification target.
NOTIFICATION_COUNTRY_NAME=Sri Lanka
