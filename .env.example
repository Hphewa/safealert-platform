# Root-level local environment notes.
# Keep real secrets in local .env files only. Never commit them.

# Public API URL used by the mobile app during development.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend configuration belongs in apps/api/.env.
# Mobile EXPO_PUBLIC_* values are client-visible and must never contain secrets.

# Backend local media storage defaults. Keep uploaded files out of source control.
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_PATH=/api/v1/media
